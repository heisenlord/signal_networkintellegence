# Public client configuration only. Never place provider keys here.
# Leave blank to use the local proxy in development and Render in production.
VITE_API_BASE_URL=
# Vercel defaults to https://signal-networkintellegence.onrender.com/api/v1.
# If setting an override in Vercel, use that full URL instead of /api/v1.
# The backend origin without /api/v1 is also accepted and normalized.
VITE_API_TIMEOUT_MS=65000
# Used by Vite's server proxy, not exposed to client JavaScript.
API_PROXY_TARGET=http://127.0.0.1:8000
