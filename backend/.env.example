# Copy to backend/.env. Never put the API key in a VITE_ variable.
SIGNAL_ENVIRONMENT=development
# Production configuration is documented in docs/deployment.md.
# SIGNAL_ALLOWED_HOSTS=["signal.example.com", "localhost"]
# SIGNAL_OIDC_ISSUER=https://identity.example.com/
# SIGNAL_OIDC_AUDIENCE=signal-api
# SIGNAL_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# auto: use Gemini when a key is present; otherwise run local evidence rules.
# llm: require a key and return a clear error if the provider fails.
# deterministic: offline mode, no model requests.
SIGNAL_AGENT_MODE=auto
SIGNAL_LLM_TIMEOUT_SECONDS=15
SIGNAL_AGENT_DEADLINE_SECONDS=30
SIGNAL_AGENT_MAX_MODEL_CALLS=4
SIGNAL_AGENT_MAX_TOOL_CALLS=16
SIGNAL_SEED_SITES=18
SIGNAL_SEED_HOURS=24
# Optional: absolute SQLite URL. Omit to use backend/data/signal.db.
# SIGNAL_DATABASE_URL=sqlite:////absolute/path/to/signal.db
# MCP process identity; not a Gemini credential.
SIGNAL_DEMO_TOKEN=demo-atlas-alarm
